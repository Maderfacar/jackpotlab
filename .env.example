# =============================================================================
# Jackpot Lab — environment variables
# Copy this file to .env.local and fill in real values (NEVER commit .env.local)
# =============================================================================

# -------- Firebase Web SDK (public — exposed to the browser) ------------------
# These are NOT secrets in Firebase's security model. The apiKey is a public
# project identifier, not an auth token. Security is enforced by Firestore
# rules + Auth providers. Still, we load them via runtimeConfig.public so
# Vercel manages them centrally.
NUXT_PUBLIC_FIREBASE_API_KEY=
NUXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NUXT_PUBLIC_FIREBASE_PROJECT_ID=
NUXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NUXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NUXT_PUBLIC_FIREBASE_APP_ID=

# -------- Firebase Admin SDK (server-only — NEVER expose) ---------------------
# Stringified JSON of a service account key. Generate at:
# https://console.firebase.google.com/project/<project>/settings/serviceaccounts/adminsdk
# Store in Vercel as a single multi-line secret.
FIREBASE_SERVICE_ACCOUNT_JSON=

# -------- Admin allowlist (server-only) ---------------------------------------
# Comma-separated list of email addresses granted admin access.
ADMIN_EMAILS=

# -------- LINE LIFF & Messaging API (Phase 2 — deferred) ----------------------
# Add when LIFF integration begins.
# NUXT_PUBLIC_LIFF_ID=
# LINE_LOGIN_CHANNEL_ID=
# LINE_LOGIN_CHANNEL_SECRET=
# LINE_MESSAGING_CHANNEL_ACCESS_TOKEN=
# LINE_MESSAGING_CHANNEL_SECRET=

# -------- App branding override (optional) ------------------------------------
# These override Firestore theme doc defaults if set.
# NUXT_PUBLIC_APP_NAME=Jackpot Lab
